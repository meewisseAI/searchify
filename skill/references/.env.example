# Search provider API keys. Set only the ones you have; each engine is skipped
# if its key is missing. Real values go in references/.env (never commit it).
TAVILY_API_KEY=      # tavily.com (free tier)
EXA_API_KEY=         # exa.ai (free tier)
SERPER_API_KEY=      # serper.dev (free Google SERP quota)
JINA_API_KEY=        # jina.ai (free tier)
